{
  "name": "language-of-flowers",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "autoprefixer": "^6.5.4",
    "concurrently": "^3.1.0",
    "css-loader": "^0.26.1",
    "css-mqpacker": "^5.0.1",
    "cssnano": "^3.9.1",
    "normalize-css": "^2.3.1",
    "postcss": "^5.2.6",
    "postcss-cli": "^2.6.0",
    "postcss-custom-media": "^5.0.1",
    "postcss-import": "^9.0.0",
    "postcss-pxtorem": "^3.3.1",
    "postcss-scss": "^0.4.0",
    "precss": "^1.4.0",
    "react-scripts": "0.8.4",
    "source-map": "^0.5.6"
  },
  "dependencies": {
    "react": "^15.4.1",
    "react-dom": "^15.4.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "watch": "concurrently --names 'webpack,postcss' --prefix name 'npm run start' 'npm run styles:watch'",
    "build": "react-scripts build",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "styles": "postcss -c postcss.config.js",
    "styles:watch": "postcss -c postcss.config.js -w"
  },
  "eslintConfig": {
    "extends": "./node_modules/react-scripts/config/eslint.js"
  }
}
